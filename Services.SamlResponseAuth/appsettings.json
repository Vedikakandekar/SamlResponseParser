{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "SAML": {
    "V1Namespace": "urn:oasis:names:tc:SAML:1.0:assertion",
    "V2Namespace": "urn:oasis:names:tc:SAML:2.0:assertion",
    "V1ProtocolNamespace": "urn:oasis:names:tc:SAML:1.0:protocol",
    "V2ProtocolNamespace": "urn:oasis:names:tc:SAML:2.0:protocol",
    "V1NameId": "//saml:Assertion/saml:AuthenticationStatement/saml:Subject/saml:NameIdentifier",
    "V2NameId": "//saml2:Assertion/saml2:Subject/saml2:NameID",
    "V1AttributeName": "//saml:Assertion/saml:AttributeStatement/saml:Attribute[@AttributeName=",
    "V2AttributeName": "//saml2:Assertion/saml2:AttributeStatement/saml2:Attribute[@Name=",
    "NotBefore": "//saml:Assertion/saml:Conditions/@NotBefore | //saml2:Assertion/saml2:Conditions/@NotBefore",
    "NotOnOrAfter": "//saml:Assertion/saml:Conditions/@NotOnOrAfter | //saml2:Assertion/saml2:Conditions/@NotOnOrAfter",
    "V1Issuer": "//saml:Assertion/@Issuer",
    "V2Issuer": "//saml2:Assertion/saml2:Issuer"

  }
}