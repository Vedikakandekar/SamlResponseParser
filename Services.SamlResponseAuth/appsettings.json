{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "SAML": {
    "V1Namespace": "urn:oasis:names:tc:SAML:1.0:assertion",
    "V2Namespace": "urn:oasis:names:tc:SAML:2.0:assertion",
    "V1Protocol": "urn:oasis:names:tc:SAML:1.0:protocol",
    "V2Protocol": "urn:oasis:names:tc:SAML:2.0:protocol",
    "AssertionNode": "//saml:Assertion | //saml2:Assertion",
    "StatusCode": "//samlp:Status/samlp:StatusCode/@Value | //samlp2:Status/samlp2:StatusCode/@Value",
    "NotBefore": "//saml:Assertion/saml:Conditions/@NotBefore | //saml2:Assertion/saml2:Conditions/@NotBefore",
    "NotOnOrAfter": "//saml:Assertion/saml:Conditions/@NotOnOrAfter | //saml2:Assertion/saml2:Conditions/@NotOnOrAfter",
    "V1Issuer": "//saml:Assertion/@Issuer",
    "V2Issuer": "//saml2:Assertion/saml2:Issuer",
    "Attribute": "//saml:Assertion/saml:AttributeStatement/saml:Attribute | //saml2:Assertion/saml2:AttributeStatement/saml2:Attribute",
    "AttributeValue": "saml:AttributeValue | saml2:AttributeValue",
    "DateFormat": "yyyy-MM-ddTHH:mm:ss.fffZ",
    "V1AttributeName": "AttributeName",
    "V2AttributeName": "Name",
    "EmailAttributeName": "email",
    "V1StatusSuccess": "samlp:Success",
    "V2StatusSuccess": "urn:oasis:names:tc:SAML:2.0:status:Success"
  }


}